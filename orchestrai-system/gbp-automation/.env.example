# GoHighLevel API Credentials

# 1. Create Private Integration API Key 2.0:
#    Agency Settings → Integrations → Private Integrations → Create New
#    Scopes needed: social-planner.write, social-planner.readonly, locations.readonly
GHL_ACCESS_TOKEN=your_private_integration_api_key_here

# 2. Get Location ID:
#    Sub-Account Dashboard → Settings → Business Profile → Copy Location ID
GHL_LOCATION_ID=your_location_id_here
