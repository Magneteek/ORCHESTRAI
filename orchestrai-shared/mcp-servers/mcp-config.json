{
  "mcpServers": {
    "sequential-thinking": {
      "name": "sequential-thinking", 
      "description": "Advanced problem-solving with multi-agent coordination",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"],
      "env": {
        "GROQ_API_KEY": "${GROQ_API_KEY}",
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "capabilities": ["complex-problem-solving", "iterative-refinement", "multi-step-analysis"],
      "priority": "high",
      "enabled": true
    },
    "ref-tools": {
      "name": "ref-tools",
      "description": "Documentation access for hallucination prevention",
      "command": "npx",
      "args": ["ref-tools-mcp"],
      "env": {
        "REF_API_KEY": "${REF_API_KEY}"
      },
      "capabilities": ["documentation-search", "web-scraping", "fact-checking"],
      "priority": "high",
      "enabled": true
    },
    "dataforseo": {
      "name": "dataforseo",
      "description": "Custom SEO data integration server",
      "command": "node",
      "args": ["./orchestrai-shared/mcp-servers/dataforseo-server.js"],
      "env": {
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      },
      "capabilities": ["seo-analysis", "keyword-research", "serp-data"],
      "priority": "medium",
      "enabled": true
    },
    "memory": {
      "name": "memory",
      "description": "Persistent knowledge graphs",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-memory"],
      "capabilities": ["knowledge-storage", "context-persistence", "learning-retention"],
      "priority": "high", 
      "enabled": true
    },
    "filesystem": {
      "name": "filesystem",
      "description": "Secure file operations",
      "command": "npx", 
      "args": ["@modelcontextprotocol/server-filesystem", "/Users/kris/CLAUDEtools/ORCHESTRAI/projects", "/Users/kris/CLAUDEtools/ORCHESTRAI/orchestrai-system/templates"],
      "capabilities": ["file-operations", "path-validation", "secure-access"],
      "priority": "medium",
      "enabled": true,
      "allowedDirectories": [
        "/Users/kris/CLAUDEtools/ORCHESTRAI/projects",
        "/Users/kris/CLAUDEtools/ORCHESTRAI/orchestrai-system/templates",
        "/Users/kris/CLAUDEtools/ORCHESTRAI/temp"
      ]
    },
    "notion": {
      "name": "notion",
      "description": "Auto-sync research documents and content to Notion workspace",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      },
      "capabilities": ["document-sync", "content-creation", "research-storage", "workspace-integration"],
      "priority": "high",
      "enabled": true,
      "autoSync": {
        "researchDocuments": true,
        "contentArticles": true,
        "webpageContent": true,
        "syncInterval": "real-time"
      }
    },
    "browser-mcp": {
      "name": "browser-mcp", 
      "description": "Lightweight browser automation using Playwright for visual testing",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"],
      "env": {},
      "capabilities": [
        "visual-regression-testing",
        "screenshot-capture", 
        "accessibility-validation",
        "wcag-compliance-checking",
        "core-web-vitals-measurement",
        "performance-monitoring",
        "responsive-design-validation"
      ],
      "priority": "high",
      "enabled": true,
      "webQualityDomain": {
        "role": "primary-visual-testing",
        "agents": ["visual-regression-tester", "ux-quality-validator", "responsive-design-validator", "performance-quality-tester"],
        "useCases": [
          "Quick visual validation cycles",
          "Accessibility compliance checking", 
          "Performance metrics capture",
          "Responsive design verification"
        ]
      }
    },
    "playwright-mcp": {
      "name": "playwright-mcp",
      "description": "Comprehensive cross-browser testing and E2E automation",
      "command": "npx", 
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chrome", "--device", "Desktop Chrome"],
      "env": {},
      "capabilities": [
        "cross-browser-testing",
        "e2e-user-flows",
        "multi-device-testing",
        "complex-interactions",
        "authentication-flows",
        "file-upload-testing",
        "mobile-device-emulation",
        "network-condition-testing"
      ],
      "priority": "high", 
      "enabled": true,
      "webQualityDomain": {
        "role": "comprehensive-e2e-testing",
        "agents": ["e2e-testing-coordinator", "browser-compatibility-validator", "ux-flow-validator"],
        "browsers": ["chromium", "firefox", "webkit"],
        "useCases": [
          "Complex user journey testing",
          "Cross-browser compatibility validation", 
          "Mobile responsive testing",
          "Authentication and security flows"
        ]
      }
    },
    "magicui": {
      "name": "magicui",
      "description": "Professional animated UI components library with 150+ React components",
      "command": "npx",
      "args": ["-y", "@magicuidesign/mcp@latest"],
      "env": {},
      "capabilities": [
        "animated-components",
        "react-ui-library", 
        "professional-animations",
        "component-generation",
        "ui-enhancement",
        "framer-motion-integration",
        "copy-paste-components"
      ],
      "priority": "high",
      "enabled": true,
      "webQualityDomain": {
        "role": "ui-component-enhancement",
        "agents": ["ui-component-generator", "animation-specialist", "web-developer"],
        "componentCategories": [
          "marquee", "border-beam", "blur-fade", "particle-effects", 
          "animated-cards", "interactive-dock", "globe-visualization", 
          "device-mockups", "loading-animations", "text-effects"
        ],
        "useCases": [
          "Professional website animations",
          "Interactive UI components",
          "Modern dental website enhancement",
          "Copy-paste component integration"
        ]
      }
    }
  },
  "serverConfig": {
    "maxConcurrentConnections": 10,
    "connectionTimeout": 30000,
    "retryAttempts": 3,
    "healthCheckInterval": 60000,
    "logLevel": "info"
  },
  "securityConfig": {
    "allowedOrigins": ["localhost:3000"],
    "rateLimiting": {
      "enabled": true,
      "maxRequests": 1000,
      "windowMs": 900000
    },
    "pathValidation": true,
    "sandboxed": true
  }
}