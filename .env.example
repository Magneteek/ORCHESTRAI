# ORCHESTRAI Environment Configuration

# Core API Keys
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/orchestrai
REDIS_URL=redis://localhost:6379

# MCP Server Configuration
DATAFORSEO_USERNAME=your_dataforseo_username
DATAFORSEO_PASSWORD=your_dataforseo_password
REF_API_KEY=your_ref_tools_api_key
NOTION_TOKEN=your_notion_integration_token

# N8N Workflow Automation
N8N_API_URL=https://aia.magneteek.com
N8N_API_KEY=your_n8n_api_key_here

# Google Service Account (for GSC MCP)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gsc-service-account.json

# External APIs
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
EXA_API_KEY=your_exa_api_key_here

# Enrichment APIs
APOLLO_API_KEY=your_apollo_io_api_key_here

# Application Configuration
NODE_ENV=development
PORT=5500
NEXT_PUBLIC_APP_URL=http://localhost:5500

# Crystalline Memory Configuration
CRYSTALLINE_MEMORY_MAX_NODES=10000
CRYSTALLINE_MEMORY_TTL=86400
MEMORY_POOL_SIZE=1000

# Pipeline Sharing Configuration
PIPELINE_MAX_CONCURRENT=10
PIPELINE_TIMEOUT=300000
PIPELINE_RETRY_ATTEMPTS=3

# Geometric Orchestration Configuration
ORCHESTRATION_TOPOLOGY=hybrid-mesh
MAX_AGENT_CONNECTIONS=50
DYNAMIC_ROUTING_ENABLED=true

# Dashboard Configuration
DASHBOARD_REFRESH_INTERVAL=5000
D3_VISUALIZATION_FPS=60
REAL_TIME_UPDATES=true

# Logging and Monitoring
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:5500
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=900000

# File Management Configuration
TEMP_CLEANUP_INTERVAL=3600000
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=json,md,txt,csv,png,jpg,svg

# Agent Configuration
MAX_PARALLEL_AGENTS=10
AGENT_TIMEOUT=600000
CONTEXT_WINDOW_SIZE=100000
TOKEN_USAGE_TRACKING=true