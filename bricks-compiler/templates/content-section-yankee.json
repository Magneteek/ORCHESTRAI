{"content": [{"id": "9479a4", "name": "section", "parent": 0, "children": ["329891", "5a2827", "539776", "ddcded"], "settings": {"_cssGlobalClasses": ["vexrsr", "acss_import_bg--ultra-light"]}, "label": "Content Section Yankee"}, {"id": "329891", "name": "container", "parent": "9479a4", "children": ["2bbcaa", "632266", "be3ec1"], "settings": {"_cssGlobalClasses": ["u7fvr4"]}, "label": "Content Grid Yankee"}, {"id": "2bbcaa", "name": "block", "parent": "329891", "children": ["0960ea"], "settings": {"_cssGlobalClasses": ["yk103y"]}, "label": "Heading Wrapper"}, {"id": "0960ea", "name": "heading", "parent": "2bbcaa", "children": [], "settings": {"text": "Beyond Earth: Humanity's Next Giant Leap could happen in the next 10 years", "tag": "h2", "_cssGlobalClasses": ["48x2yo"], "_attributes": [{"id": "kkonew", "name": "data-heading"}]}, "label": "Heading"}, {"id": "632266", "name": "block", "parent": "329891", "children": ["a551dc"], "settings": {"_cssGlobalClasses": ["r7818p"]}, "label": "Media Wrapper"}, {"id": "a551dc", "name": "image", "parent": "632266", "children": [], "settings": {"_cssGlobalClasses": ["arlujk"], "image": {"url": "https://krisbal.com/wp-content/themes/bricks/assets/images/placeholder-svg.svg", "full": "https://krisbal.com/wp-content/themes/bricks/assets/images/placeholder-svg.svg", "isPlaceholder": true, "path": "/home/460272.cloudwaysapps.com/akfhjeexrj/public_html/wp-content/themes/bricks/assets/images/placeholder-svg.svg"}, "tag": "figure", "loading": "eager"}, "label": "Media", "themeStyles": []}, {"id": "be3ec1", "name": "block", "parent": "329891", "children": ["ae969a"], "settings": {"_cssGlobalClasses": ["a9ubsf"]}, "label": "Content Wrapper"}, {"id": "ae969a", "name": "text", "parent": "be3ec1", "children": [], "settings": {"_cssGlobalClasses": ["n5pp9g"], "text": "<p>As we enter a new era of space exploration, science fiction is becoming reality. Advanced technology is transforming our capabilities beyond Earth's atmosphere.</p><p>The mission is clear: establish lunar bases and reach Mars. The current goal is to land a person on Mars by 2035, followed by the possibility of public space travel. Would you buy a ticket?</p>"}, "label": "Content"}, {"id": "5a2827", "name": "container", "parent": "9479a4", "children": ["469d5d", "9afa30", "1ddc4b", "4a4c8e"], "settings": {"_cssGlobalClasses": ["59iani"], "tag": "ul"}, "label": "Social Proof Yankee"}, {"id": "469d5d", "name": "div", "parent": "5a2827", "children": ["5842d9", "882458"], "settings": {"_cssGlobalClasses": ["0a48t7"], "tag": "li"}, "label": "Card"}, {"id": "5842d9", "name": "text-basic", "parent": "469d5d", "children": [], "settings": {"tag": "p", "text": "$1.3 Trillion", "_cssGlobalClasses": ["sl406r"]}, "label": "Card Value"}, {"id": "882458", "name": "text-basic", "parent": "469d5d", "children": [], "settings": {"text": "Projected value of the global space economy by 2030", "tag": "p", "_cssGlobalClasses": ["6kilx3"]}, "label": "Card Description"}, {"id": "9afa30", "name": "div", "parent": "5a2827", "children": ["312b8e", "350878"], "settings": {"_cssGlobalClasses": ["0a48t7"], "tag": "li"}, "label": "Card"}, {"id": "312b8e", "name": "text-basic", "parent": "9afa30", "children": [], "settings": {"tag": "p", "text": "225 Million", "_cssGlobalClasses": ["sl406r"]}, "label": "Card Value"}, {"id": "350878", "name": "text-basic", "parent": "9afa30", "children": [], "settings": {"text": "The average distance to Mars is a whopping 225 million km.", "tag": "p", "_cssGlobalClasses": ["6kilx3"]}, "label": "Card Description"}, {"id": "1ddc4b", "name": "div", "parent": "5a2827", "children": ["4b0862", "73c81b"], "settings": {"_cssGlobalClasses": ["0a48t7"], "tag": "li"}, "label": "Card"}, {"id": "4b0862", "name": "text-basic", "parent": "1ddc4b", "children": [], "settings": {"tag": "p", "text": "8.6 Billion", "_cssGlobalClasses": ["sl406r"]}, "label": "Card Value"}, {"id": "73c81b", "name": "text-basic", "parent": "1ddc4b", "children": [], "settings": {"text": "The number of Earth-like planets estimated to exist in our galaxy.", "tag": "p", "_cssGlobalClasses": ["6kilx3"]}, "label": "Card Description"}, {"id": "4a4c8e", "name": "div", "parent": "5a2827", "children": ["96cfee", "90e8f7"], "settings": {"_cssGlobalClasses": ["0a48t7"], "tag": "li"}, "label": "Card"}, {"id": "96cfee", "name": "text-basic", "parent": "4a4c8e", "children": [], "settings": {"tag": "p", "text": "40% Decrease", "_cssGlobalClasses": ["sl406r"]}, "label": "Card Value"}, {"id": "90e8f7", "name": "text-basic", "parent": "4a4c8e", "children": [], "settings": {"text": "The reduction in space launch costs over the past decade.", "tag": "p", "_cssGlobalClasses": ["6kilx3"]}, "label": "Card Description"}, {"id": "539776", "name": "code", "parent": "9479a4", "children": [], "settings": {"javascriptCode": "function wrapHeadingLines() { const headings = document.querySelectorAll('[data-heading]'); headings.forEach(heading => { const computedStyle = window.getComputedStyle(heading); const headingWidth = heading.offsetWidth; const measure = document.createElement('span'); measure.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;font:'+computedStyle.font; document.body.appendChild(measure); const text = heading.textContent; const words = text.split(/(\\s+)/); let lines = [], currentLine = []; words.forEach(word => { measure.textContent = currentLine.join('') + word; if (measure.offsetWidth > headingWidth && currentLine.length > 0) { lines.push(currentLine.join('')); currentLine = [word]; } else { currentLine.push(word); } }); if (currentLine.length > 0) { lines.push(currentLine.join('')); } document.body.removeChild(measure); heading.innerHTML = lines.map(line => '<span class=\"line\" style=\"display:block;\">'+line+'</span>').join(''); }); } document.addEventListener('DOMContentLoaded', wrapHeadingLines); let resizeTimer; window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(wrapHeadingLines, 250); });", "executeCode": true, "noRoot": true}, "label": "Headline Line Styles", "themeStyles": []}, {"id": "ddcded", "name": "fr-notes", "parent": "9479a4", "children": [], "settings": {"_cssGlobalClasses": ["ieofwl"], "notesContent": "<h2>Instructions</h2><p>See Frames documentation.</p>"}}], "source": "bricksCopiedElements", "sourceUrl": "https://krisbal.com", "version": "2.3.5", "globalClasses": [{"id": "vexrsr", "name": "content-section-yankee", "settings": {"_rowGap": "var(--content-gap)", "_padding": {"top": "var(--section-space-l)", "bottom": "var(--section-space-l)"}}}, {"id": "acss_import_bg--ultra-light", "name": "bg--ultra-light", "settings": [], "category": "acss"}, {"id": "u7fvr4", "name": "content-grid-yankee", "settings": {"_cssCustom": ".content-grid-yankee { --media-span: 7; --heading-span: 7; display: grid; position: relative; isolation: isolate; gap: var(--content-gap); } @media (min-width: 768px) { .content-grid-yankee { grid-template-columns: var(--grid-12); grid-template-rows: repeat(3, 1fr); } }"}}, {"id": "yk103y", "name": "content-grid-yankee__heading-wrapper", "settings": {"_cssCustom": "@media (min-width: 768px) { .content-grid-yankee__heading-wrapper { grid-column: 1 / -1; } }"}}, {"id": "48x2yo", "name": "content-grid-yankee__heading", "settings": {"_typography": {"font-size": "var(--h1)", "text-transform": "capitalize"}}}, {"id": "r7818p", "name": "content-grid-yankee__media-wrapper", "settings": {"_cssCustom": "@media (min-width: 768px) { .content-grid-yankee__media-wrapper { grid-column: 1 / 8; grid-row: 2; } }"}}, {"id": "arlujk", "name": "content-grid-yankee__media", "settings": {"_width": "100%", "_height": "100%", "_objectFit": "cover"}}, {"id": "a9ubsf", "name": "content-grid-yankee__content-wrapper", "settings": {"_padding": {"top": "var(--space-l)", "right": "var(--space-l)", "bottom": "var(--space-l)", "left": "var(--space-l)"}, "_background": {"color": {"raw": "var(--bg-dark)"}}, "_cssCustom": "@media (min-width: 768px) { .content-grid-yankee__content-wrapper { grid-column: 8 / 13; grid-row: 2; } }"}}, {"id": "n5pp9g", "name": "content-grid-yankee__content", "settings": {"_width": "100%"}}, {"id": "59iani", "name": "social-proof-yankee", "settings": {"_display": "grid", "_gridTemplateColumns": "var(--grid-4)", "_gridTemplateColumns:tablet_portrait": "var(--grid-2)", "_gridTemplateColumns:mobile_portrait": "var(--grid-1)"}}, {"id": "0a48t7", "name": "social-proof-yankee__card", "settings": {"_display": "flex", "_direction": "column", "_rowGap": ".25em", "_typography": {"text-align": "center"}}}, {"id": "sl406r", "name": "social-proof-yankee__card-value", "settings": {"_typography": {"font-size": "var(--text-xl)", "font-weight": "700"}}}, {"id": "6kilx3", "name": "social-proof-yankee__card-description", "settings": []}, {"id": "ieofwl", "name": "fr-note", "settings": {}}]}