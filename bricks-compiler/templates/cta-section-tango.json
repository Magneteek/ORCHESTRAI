        "_gridTemplateColumns": "var(--grid-2)",
        "_gridTemplateRows": "var(--grid-1)",
        "_cssCustom": "/* Set min height to avoid layout shifts */\n.image-group-tango {\n  min-height: 675px;\n}\n\n/* Shape the 1st image */\n.image-group-tango > *:first-child {\n  grid-column: 1/-1;\n  width: 90%;\n}\n\n/* Shape the 2nd image */\n.image-group-tango > *:nth-child(2) {\n  width: 100%;\n  aspect-ratio: 16/9;\n}\n\n/* Shape the 3rd image */\n.image-group-tango > *:nth-child(3) {\n  width: 100%;  \n  aspect-ratio: 5/3.5;\n}",
