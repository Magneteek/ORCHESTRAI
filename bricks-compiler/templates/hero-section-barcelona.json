      "name": "hero-barcelona__sliders",
      "settings": {
        "_display": "grid",
        "_gridTemplateColumns": "var(--grid-3)",
        "_gridGap": "var(--content-gap)",
        "_cssCustom": ".hero-barcelona__sliders {\n  --max-height: 800px;\n  --slide-speed: 50s;\n  pointer-events: none;\n}\n\n/* Begin Fade Block */\n.hero-barcelona__sliders {\n\t  --fade-amount: 25%;\n\t-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black var(--fade-amount), black calc(100% - var(--fade-amount)), transparent 100%);\n\tmask-image: linear-gradient(to bottom, transparent 0%, black var(--fade-amount), black calc(100% - var(--fade-amount)), transparent 100%);\n}\n\n/* End Fade Block */\n\n/* Animations */\n\n@keyframes barcelonaSlider {\n    0% {\n        transform: translateY(0);\n    }\n    100% {\n        transform: translateY(-50%);\n    }\n}\n\n@keyframes barcelonaSliderForward {\n    from {\n        transform: translateY(-50%);\n    }\n    to {\n        transform: translateY(0);\n    }\n}",
        "_position": "relative",
        "_heightMax": "var(--max-height)",
        "_cssCustom:mobile_landscape": ".hero-barcelona__sliders {\n  --max-height: 400px;\n}",
        "_overflow": "clip"
      },
