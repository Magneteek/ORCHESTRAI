      "settings": {
        "_cssCustom": ".fr-hero-papa__list {\n  /* How many list columns should there be? */\n  --column-count: 2;\n  /* List item font size? */\n\t--list-item-font-size: var(--text-l);\n  /* Row gap between list items? */\n  --list-item-margin: 1em;\n  /* Column gap inside the list? */\n  --list-item-column-gap: calc(var(--grid-gap) * 2);\n  /* What column width should the columns stack at? */\n  --minimum-column-width: 10em;\n  /* Manage the left list padding */\n  --left-padding: 1.3em;\n}\n\n.fr-hero-papa__list ol {\n  padding-inline-start: var(--left-padding);\n  display: block;\n  column-count: var(--column-count);\n  column-width: var(--minimum-column-width);\n  gap: var(--list-item-column-gap);\n  margin-block-end: calc(var(--list-item-margin) * -1);\n}\n\n.fr-hero-papa__list ol li {\n\tfont-size: var(--list-item-font-size);\n  margin-block-end: var(--list-item-margin);\n}"
