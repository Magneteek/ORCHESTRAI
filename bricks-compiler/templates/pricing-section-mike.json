    {
      "id": "mtxbyf",
      "name": "fr-pricing-grid-mike",
      "settings": {
        "_display": "grid",
        "_gridGap": "0",
        "_padding": {
          "top": "var(--grid-padding)",
          "right": "var(--grid-padding)",
          "bottom": "var(--grid-padding)",
          "left": "var(--grid-padding)"
        },
        "_border": {
          "radius": {
            "top": "var(--radius-m)",
            "right": "var(--radius-m)",
            "bottom": "var(--radius-m)",
            "left": "var(--radius-m)"
          }
        },
        "_cssCustom": "@media (min-width: 991px) {\n  .fr-pricing-grid-mike {\n    --initial-focus-index: 1; /* Default to first grid item (0 = first item, 2 = last item) */\n    --grid-width: var(--content-width);\n    --grid-padding: var(--space-l);\n    --card-padding: var(--space-l);\n    --card-border-color: var(--neutral-light-trans-10);\n    --card-border-width: 1px;--card-width: calc((100% - var(--grid-padding) * 2) / var(--card-count, 2));\n  }\n  \n  .fr-pricing-grid-mike {\n    isolation: isolate;\n    position: relative;\n    background-color: var(--neutral-dark-trans-20);\n  }\n  /* Initial position of ::before based on --initial-focus-index */\n  .fr-pricing-grid-mike::before {\n    content: '';\n    position: absolute;\n    display: flex;\n    inset-block-start: var(--grid-padding);\n    inset-inline-start: calc(var(--grid-padding) + (100% - var(--grid-padding) * 2) * (var(--initial-focus-index) / var(--card-count, 2)));\n    width: var(--card-width);height: calc(100% - (var(--grid-padding) * 2));\n    background-color: var(--neutral-dark-trans-20);\n    border: var(--card-border-width) solid var(--card-border-color);\n    border-radius: var(--radius);\n    translate: 0 0;\n    transition: translate .3s ease;\n    z-index: -1;\n  }\n\n  /* For grids with 2 items */\n  .fr-pricing-grid-mike:has(> li:nth-last-child(2)) {\n    --card-count: 2;\n    --grid: var(--grid-2);\n  }\n  \n  .fr-pricing-grid-mike:has(> li:nth-last-child(2)):has(> li:nth-child(1):hover)::before,.fr-pricing-grid-mike:has(> li:nth-last-child(2)):has(> li:nth-child(1):focus-within)::before {\n    translate: calc(-100% * var(--initial-focus-index)) 0;\n  }\n  \n  .fr-pricing-grid-mike:has(> li:nth-last-child(2)):has(> li:nth-child(2):hover)::before,.fr-pricing-grid-mike:has(> li:nth-last-child(2)):has(> li:nth-child(2):focus-within)::before {\n    translate: calc((1 - var(--initial-focus-index)) * 100%) 0;\n  }\n  /* For grids with 3 items */\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)) {--card-count: 3;--grid: var(--grid-3);\n  }\n\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)):has(> li:nth-child(1):hover)::before,\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)):has(> li:nth-child(1):focus-within)::before {\n    translate: calc(-100% * var(--initial-focus-index)) 0;\n  }\n\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)):has(> li:nth-child(2):hover)::before,\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)):has(> li:nth-child(2):focus-within)::before {\n    translate: calc((1 - var(--initial-focus-index)) * 100%) 0;\n  }\n\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)):has(> li:nth-child(3):hover)::before,\n  .fr-pricing-grid-mike:has(> li:nth-last-child(3)):has(> li:nth-child(3):focus-within)::before {\n    translate: calc((2 - var(--initial-focus-index)) * 100%) 0;\n  }\n\n  /* Focused item border enhancement */\n  .fr-pricing-grid-mike:has(> li:focus-within)::before {\n    border: 1px solid var(--white-trans-10);\n  }\n}",
        "_width": "var(--grid-width)",
        "_gridTemplateColumns": "var(--grid)",
        "_gridGap:tablet_portrait": "var(--content-gap)"
      },
