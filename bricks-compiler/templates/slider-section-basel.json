        "prevArrowLeft": "var(--space-xs)",
        "nextArrowRight": "var(--space-xs)",
        "_cssCustom": ".slider-basel {\n  --blur: 6px;\n  --arrow-color: var(--white);\n\t--arrow-size: 1.5em;\n}\n\n.slider-basel__slide:not(.is-active) {\n  filter: blur(var(--blur));\n}\n\n.slider-basel__slide :is(p, h1, h2, h3, h4, h5, h6) {\n  opacity: 0;\n  transform: translate(0px, 30px);\n  transition: 0; \n}\n.slider-basel__slide.is-active.is-visible :is(p, h1, h2, h3, h4, h5, h6) {\n  opacity: 1;\n  transform: translate(0px, 0px);\n  transition: all var(--transition-duration) var(--transition-timing) var(--transition-delay);   \n}\n\n.slider-basel .splide__arrows .splide__arrow {\n  font-size: 1.5em;\n  padding: .15em;\n  width: unset;\n  height: unset;\n\n}\n\n.slider-basel .splide__arrow > * {\n  color: var(--arrow-color); \n  width: var(--arrow-size);\n  height: var(--arrow-size);\n}\n\n.bg--ultra-dark {\n  --bg-ultra-light: var(--bg-ultra-dark);\n}",
