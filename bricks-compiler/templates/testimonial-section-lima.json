        "_alignItems": "center",
        "_columnGap": ".25em",
        "_background": {
          "color": {
            "raw": "var(--bg-ultra-light)"
          }
        },
        "_padding": {
          "top": ".5em",
          "right": ".5em",
          "bottom": ".5em",
          "left": ".5em"
        },
        "_border": {
          "radius": {
            "top": "var(--radius)",
            "right": "var(--radius)",
            "bottom": "var(--radius)",
            "left": "var(--radius)"
          }
        },
        "_cssCustom": ".fr-badge-alpha__icon-wrapper :is(svg, i) {\n  height: var(--icon-size);\n  width: var(--icon-size);\n  fill: var(--icon-fill-color);\n  color: var(--icon-stroke-color);\n}\n\n.fr-badge-alpha__icon-wrapper :is(svg, i):hover {\n  fill: var(--icon-fill-color-hover);\n  color: var(--icon-stroke-color);  \n}\n\n/* Bricks Canvas fix */\n:where(.brx-draggable:empty) {\n  min-height: unset;\n  min-width: unset;\n}"
      },
