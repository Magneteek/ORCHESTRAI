    {
      "id": "ugoynx",
      "name": "faq-list-charlie",
      "settings": {
        "_cssCustom": "/* ACSS Programmatic Dividers */\n/* Available Override Tokens\n--divider-size\n--divider-inline-size\n--divider-style\n--divider-color\n*/\n\n/* Remove gap from parent */\n.faq-list-charlie {\n  --divider-gap: calc(var(--container-gap) / 1.5);\n\trow-gap: 0 !important;\n  padding: 0;\n  margin: 0;\n  list-style-type: none;\n}\n\n/* Children are required to be relative and show overflow. They also need bottom margin to act as a gap. */\n.faq-list-charlie > *:not(:last-child) {\n\t\tposition: relative;\n\toverflow: visible;\n\tmargin-block-end: calc(var(--divider-gap) * 2);\n}\n\n/* Divider */\n.faq-list-charlie > *:not(:last-child)::after {\n\t\tcontent: '';\n\tdisplay: block;\n\tposition: absolute;\n\tinset-inline-start: 0;\n\tinset-block-end: calc(var(--divider-gap) * -1 - var(--divider-size));\n\tinline-size: var(--divider-inline-size);\n\tborder-block-end: var(--divider);\n}"
      },
