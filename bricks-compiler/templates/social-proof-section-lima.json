        "_direction": "row",
        "_flexWrap": "wrap",
        "_cssCustom": ".fr-logos-bravo {\n  --col-count: 4; /* Controls # of logo columns */\n  --col-gap: var(--content-gap); /* Gap between logos */\n  --logo-height: 2em; /* Maintains consistency */\n  \n  /* If your logos aren't aligned properly, try changing their height value to a larger value. */\n\n/* No need to edit below this line */\n  --gap-count: calc(var(--col-count) - 1);\n\tgap: var(--content-gap);\n}\n\n.fr-logos-bravo * {\n  flex-basis: calc(100% / var(--col-count) - (var(--col-gap) * var(--gap-count) / var(--col-count)));\n}\n\n.fr-logos-bravo li > * {\n  height: var(--logo-height);\n  width: 100%\n}",
        "_cssCustom:tablet_portrait": ".fr-logos-bravo > * {\n\tflex-basis: 28%;\n}",
        "_cssCustom:mobile_landscape": ".fr-logos-bravo > * {\n\tflex-basis: 20%;\n}",
