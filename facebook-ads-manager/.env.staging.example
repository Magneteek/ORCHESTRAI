# ============================================
# STAGING ENVIRONMENT VARIABLES
# ============================================
# Staging environment for testing before production deployment

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com
NODE_ENV=production
PORT=3001

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://fbads_staging:STAGING_PASSWORD@staging-db.example.com:5432/facebook_ads_manager_staging?schema=public"

POSTGRES_USER=fbads_staging
POSTGRES_PASSWORD=STAGING_PASSWORD_HERE
POSTGRES_DB=facebook_ads_manager_staging
POSTGRES_PORT=5432

# ============================================
# NextAuth.js Authentication
# ============================================
NEXTAUTH_URL=https://staging.yourdomain.com
NEXTAUTH_SECRET="STAGING_SECRET_HERE"

# ============================================
# Facebook / Meta Marketing API (Test App)
# ============================================
FACEBOOK_APP_ID=your-test-facebook-app-id
FACEBOOK_APP_SECRET=your-test-facebook-app-secret
FACEBOOK_API_VERSION=v22.0
NEXT_PUBLIC_FACEBOOK_APP_ID=your-test-facebook-app-id

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://:STAGING_REDIS_PASSWORD@staging-redis.example.com:6379
REDIS_PASSWORD=STAGING_REDIS_PASSWORD
REDIS_PORT=6379

# ============================================
# Anthropic Claude API (Staging Key)
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-STAGING_KEY_HERE

# ============================================
# Socket.io Real-time
# ============================================
NEXT_PUBLIC_SOCKET_URL=https://staging.yourdomain.com

# ============================================
# Rate Limiting (More lenient for testing)
# ============================================
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Job Queue (BullMQ)
# ============================================
BULLMQ_REDIS_HOST=staging-redis.example.com
BULLMQ_REDIS_PORT=6379

# ============================================
# Error Tracking (Sentry - Staging)
# ============================================
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/staging-project
SENTRY_ORG=your-organization
SENTRY_PROJECT=facebook-ads-manager-staging
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/staging-project

# ============================================
# Email Service (Test Mode)
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=staging@yourdomain.com

# ============================================
# AWS Configuration (Staging)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-staging-aws-access-key
AWS_SECRET_ACCESS_KEY=your-staging-aws-secret-key
AWS_S3_BUCKET=your-staging-s3-bucket

# ============================================
# Vercel Deployment (Staging)
# ============================================
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-staging-project-id

# ============================================
# Feature Flags (All enabled for testing)
# ============================================
FEATURE_AI_INSIGHTS_ENABLED=true
FEATURE_TEMPLATE_MARKETPLACE_ENABLED=true
FEATURE_REAL_TIME_ANALYTICS_ENABLED=true

# ============================================
# Staging-Specific Settings
# ============================================
LOG_LEVEL=debug
ENABLE_DEBUG_LOGGING=true
ENABLE_QUERY_LOGGING=true

# Allow test data seeding
ALLOW_DATA_SEEDING=true

# Staging banner
NEXT_PUBLIC_ENVIRONMENT=staging
