// Prisma schema for Facebook Ads Manager SaaS Platform
// Multi-tenant architecture with Row Level Security

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MULTI-TENANCY & AUTHENTICATION ============

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, starter, professional, enterprise
  status    String   @default("active") // active, suspended, cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  facebookBusinessAccounts FacebookBusinessAccount[]
  adTemplates             AdTemplate[]

  @@map("organizations")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  password       String? // Hashed, null if OAuth only
  role           UserRole @default(USER) // Simplified: ADMIN (admin/manager) or USER (member)
  organizationId String
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

// NextAuth.js models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============ FACEBOOK INTEGRATION ============

model FacebookBusinessAccount {
  id                   String   @id @default(uuid())
  organizationId       String
  businessId           String   // Facebook Business Manager ID
  name                 String
  accessTokenEncrypted String   // Encrypted long-lived token
  systemUserToken      String?  // System User token (non-expiring)
  tokenExpiresAt       DateTime?
  isActive             Boolean  @default(true)
  lastSyncAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccounts   AdAccount[]

  @@unique([organizationId, businessId])
  @@index([organizationId])
  @@map("facebook_business_accounts")
}

model AdAccount {
  id                       String   @id @default(uuid())
  facebookBusinessAccountId String
  accountId                String   // Facebook Ad Account ID (act_xxx)
  name                     String
  currency                 String
  timezone                 String
  accountStatus            String   @default("ACTIVE")
  lastSyncAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  facebookBusinessAccount FacebookBusinessAccount @relation(fields: [facebookBusinessAccountId], references: [id], onDelete: Cascade)
  campaigns               Campaign[]
  aiAnalysis              AiAnalysis[]

  @@unique([facebookBusinessAccountId, accountId])
  @@index([facebookBusinessAccountId])
  @@map("ad_accounts")
}

// ============ TEMPLATE SYSTEM ============

model AdTemplate {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  category          String   // e-commerce, lead-generation, brand-awareness, etc.
  objective         String   // OUTCOME_TRAFFIC, OUTCOME_LEADS, OUTCOME_SALES, etc.
  visibility        String   @default("private") // private, public
  version           Int      @default(1)
  parentTemplateId  String?  // For versioning/forking

  // Template Content
  adCopy            Json     // { headline, primaryText, description, callToAction }
  creativeSpecs     Json     // { imageUrl, videoUrl, format, dimensions }
  targetingConfig   Json     // { interests, demographics, behaviors, locations }
  campaignStructure Json     // { budget, bidStrategy, placements, schedule }

  // Dynamic Fields Support
  dynamicFields     Json?    // Schema: { fields: [{ name, type, required, defaultValue, placeholder }] }
  fieldSchema       Json?    // JSON Schema for validation
  isGlobal          Boolean  @default(false) // Available to all organizations
  requiresApproval  Boolean  @default(false) // Future feature flag

  // Performance Tracking
  timesUsed         Int      @default(0)
  isPublic          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceAggregate   TemplatePerformanceAggregate?
  campaigns              Campaign[]
  ads                    Ad[]
  templateLaunches       TemplateLaunch[]

  @@index([organizationId])
  @@index([visibility, category])
  @@index([isGlobal])
  @@map("ad_templates")
}

model TemplatePerformanceAggregate {
  id              String   @id @default(uuid())
  templateId      String   @unique

  // Aggregated Metrics
  totalSpend      Float    @default(0)
  totalImpressions BigInt  @default(0)
  totalClicks     BigInt   @default(0)
  totalConversions BigInt  @default(0)
  avgRoas         Float?
  avgCtr          Float?
  avgCpc          Float?
  avgCpm          Float?

  accountsUsing   Int      @default(0)
  lastUpdated     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template AdTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([avgRoas])
  @@map("template_performance_aggregate")
}

model TemplateLaunch {
  id          String   @id @default(uuid())
  templateId  String
  campaignId  String
  adAccountId String
  userId      String
  fieldValues Json     // Resolved dynamic field values
  createdAt   DateTime @default(now())

  template AdTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaign Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([campaignId])
  @@index([userId])
  @@map("template_launches")
}

// ============ FACEBOOK AD STRUCTURE ============

model Campaign {
  id             String   @id @default(uuid())
  adAccountId    String
  campaignId     String   // Facebook Campaign ID
  name           String
  objective      String   // Facebook objective
  status         String   // ACTIVE, PAUSED, DELETED
  templateId     String?  // Reference to template if launched from template

  // Metadata
  dailyBudget    Float?
  lifetimeBudget Float?
  bidStrategy    String?
  startTime      DateTime?
  stopTime       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adAccount        AdAccount        @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  template         AdTemplate?      @relation(fields: [templateId], references: [id])
  adSets           AdSet[]
  templateLaunches TemplateLaunch[]

  @@unique([adAccountId, campaignId])
  @@index([adAccountId])
  @@index([templateId])
  @@map("campaigns")
}

model AdSet {
  id               String   @id @default(uuid())
  campaignId       String
  adSetId          String   // Facebook Ad Set ID
  name             String
  status           String

  // Targeting & Budget
  targeting        Json
  budget           Float?
  bidStrategy      String?
  billingEvent     String?
  optimizationGoal String?

  startTime        DateTime?
  endTime          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@unique([campaignId, adSetId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id          String   @id @default(uuid())
  adSetId     String
  adId        String   // Facebook Ad ID
  name        String
  status      String
  templateId  String?  // Reference to template

  // Creative
  creative    Json     // { imageUrl, videoUrl, headline, primaryText, description, cta }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adSet              AdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  template           AdTemplate? @relation(fields: [templateId], references: [id])
  performanceMetrics PerformanceMetric[]

  @@unique([adSetId, adId])
  @@index([adSetId])
  @@index([templateId])
  @@map("ads")
}

// ============ PERFORMANCE METRICS ============

model PerformanceMetric {
  id           String   @id @default(uuid())
  adId         String
  date         DateTime

  // Core Metrics
  spend         Float    @default(0)
  impressions   BigInt   @default(0)
  clicks        BigInt   @default(0)
  conversions   BigInt   @default(0)
  // Purchase conversion value (revenue) for the day, from Facebook action_values.
  // Aggregate ROAS = sum(purchaseValue) / sum(spend) — never average per-row roas.
  purchaseValue Float?

  // Calculated Metrics
  roas         Float?
  ctr          Float?
  cpc          Float?
  cpm          Float?
  cpa          Float?

  // Additional Metrics
  reach        BigInt?
  frequency    Float?
  videoViews   BigInt?

  createdAt    DateTime @default(now())

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([adId])
  @@index([date])
  @@map("performance_metrics")
}

// ============ AI ANALYSIS ============

model AiAnalysis {
  id             String   @id @default(uuid())
  adAccountId    String
  analysisType   String   // performance_prediction, anomaly_detection, copy_optimization, audience_insights

  // Analysis Results
  insights       Json     // AI-generated insights
  recommendations Json    // Actionable recommendations
  confidence     Float?   // Confidence score 0-1

  // Metadata
  analyzedAt     DateTime @default(now())
  validUntil     DateTime? // Cache expiry
  createdAt      DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@index([adAccountId, analysisType])
  @@index([analyzedAt])
  @@map("ai_analysis")
}

model AnomalyDetection {
  id          String   @id @default(uuid())
  adAccountId String   // Not a foreign key to allow flexibility
  entityType  String   // campaign, adset, ad
  entityId    String   // Facebook entity ID
  metric      String   // spend, roas, ctr, etc.

  // Anomaly Details
  severity    String   // minor, moderate, critical
  description String
  currentValue Float
  expectedValue Float
  deviation   Float    // Percentage deviation

  // Status
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  detectedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([adAccountId, isResolved])
  @@index([detectedAt])
  @@map("anomaly_detections")
}
