# Application
NEXT_PUBLIC_APP_URL=http://localhost:3001
PORT=3001

# Do NOT set NODE_ENV here. Next.js sets it per command (development for
# `next dev`, production for `next build`/`next start`) and reads .env.local
# during the build, so pinning it in an env file forces a production build to
# run in development mode. That is what broke `next build` — static generation
# of /404 failed with "<Html> should not be imported outside of pages/_document"
# and Next printed a "non-standard NODE_ENV" warning above it.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/facebook_ads_manager?schema=public"

# NextAuth.js
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Facebook / Meta
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_API_VERSION=v22.0
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Socket.io
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Job Queue
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Required by /api/cron/* routes. Vercel Cron sends it as a Bearer token.
# Routes fail closed (503) if unset. Generate: openssl rand -hex 32
CRON_SECRET=
