# Facebook Ads Manager - Production Environment Variables Template
# Copy this file to .env.production and fill in the actual values

# =======================
# DATABASE CONFIGURATION
# =======================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://fbads:YOUR_DATABASE_PASSWORD@localhost:5432/facebook_ads_manager"

# =======================
# NEXTAUTH CONFIGURATION
# =======================
# NextAuth.js configuration for authentication
# URL where the application is hosted (must match domain)
NEXTAUTH_URL="https://your-domain.com"

# Secret key for JWT token encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="YOUR_NEXTAUTH_SECRET_HERE"

# =======================
# FACEBOOK API
# =======================
# Facebook App credentials from https://developers.facebook.com/apps
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"

# Facebook Graph API version
FACEBOOK_API_VERSION="v18.0"

# =======================
# REDIS CONFIGURATION
# =======================
# Redis connection for caching and session management
REDIS_URL="redis://localhost:6379"

# Redis password (if authentication is enabled)
# REDIS_PASSWORD="your_redis_password"

# =======================
# ENCRYPTION
# =======================
# Secret key for encrypting sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_SECRET="YOUR_ENCRYPTION_SECRET_HERE"

# =======================
# EMAIL CONFIGURATION
# =======================
# SMTP settings for sending user invitations and notifications
# Using SendGrid as example (can use any SMTP provider)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your_sendgrid_api_key"
SMTP_FROM="noreply@your-domain.com"
SMTP_FROM_NAME="Facebook Ads Manager"

# =======================
# APPLICATION SETTINGS
# =======================
# Application environment
NODE_ENV="production"

# Application port (default: 3001)
PORT="3001"

# Base URL for API calls
NEXT_PUBLIC_API_URL="https://your-domain.com/api"

# =======================
# FEATURES FLAGS
# =======================
# Enable/disable AI-powered recommendations
ENABLE_AI_RECOMMENDATIONS="true"

# Enable/disable analytics tracking
ENABLE_ANALYTICS="true"

# Enable/disable debug logging
DEBUG="false"

# =======================
# ANTHROPIC AI (OPTIONAL)
# =======================
# For AI-powered content suggestions and recommendations
# ANTHROPIC_API_KEY="your_anthropic_api_key"

# =======================
# MONITORING (OPTIONAL)
# =======================
# Sentry for error tracking
# SENTRY_DSN="your_sentry_dsn"

# New Relic for APM
# NEW_RELIC_LICENSE_KEY="your_newrelic_key"
# NEW_RELIC_APP_NAME="facebook-ads-manager"

# =======================
# EXTERNAL SERVICES (OPTIONAL)
# =======================
# AWS S3 for file storage (if using)
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# Digital Ocean Spaces for backups (if using)
# SPACES_ACCESS_KEY="your_spaces_access_key"
# SPACES_SECRET_KEY="your_spaces_secret_key"
# SPACES_ENDPOINT="nyc3.digitaloceanspaces.com"
# SPACES_BUCKET="facebook-ads-manager-backups"

# =======================
# SECURITY
# =======================
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# Rate limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Session configuration
SESSION_MAX_AGE="86400"  # 24 hours in seconds
SESSION_UPDATE_AGE="3600"  # 1 hour in seconds

# =======================
# LOGGING
# =======================
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# Log format (json or pretty)
LOG_FORMAT="json"

# =======================
# PRISMA
# =======================
# Prisma connection pool settings
PRISMA_CONNECTION_LIMIT="20"
PRISMA_POOL_TIMEOUT="30"

# =======================
# NOTES
# =======================
# 1. Never commit this file with real values to version control
# 2. Use strong, randomly generated passwords and secrets
# 3. Regularly rotate secrets (every 90 days)
# 4. Use environment-specific values (staging vs production)
# 5. Store backups of this file securely (encrypted)
# 6. Limit access to this file (chmod 600)
