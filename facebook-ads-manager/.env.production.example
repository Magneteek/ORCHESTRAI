# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# CRITICAL: Replace all placeholder values before deployment
# NEVER commit actual production secrets to version control

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=production
PORT=3001

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Production database URL (use connection pooling in production)
DATABASE_URL="postgresql://fbads:STRONG_PASSWORD_HERE@localhost:5432/facebook_ads_manager?schema=public&connection_limit=20&pool_timeout=10"

# Docker compose variables
POSTGRES_USER=fbads
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=facebook_ads_manager
POSTGRES_PORT=5432

# ============================================
# NextAuth.js Authentication
# ============================================
NEXTAUTH_URL=https://yourdomain.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="GENERATE_STRONG_SECRET_HERE"

# ============================================
# Facebook / Meta Marketing API
# ============================================
FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=your-production-facebook-app-secret
FACEBOOK_API_VERSION=v22.0
NEXT_PUBLIC_FACEBOOK_APP_ID=your-production-facebook-app-id

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://:REDIS_PASSWORD_HERE@localhost:6379
REDIS_PASSWORD=REDIS_PASSWORD_HERE
REDIS_PORT=6379

# ============================================
# Anthropic Claude API
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-PRODUCTION_KEY_HERE

# ============================================
# Socket.io Real-time
# ============================================
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Job Queue (BullMQ)
# ============================================
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379

# ============================================
# Error Tracking (Sentry)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-organization
SENTRY_PROJECT=facebook-ads-manager
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Monitoring & Analytics
# ============================================
# Vercel Analytics (if using Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# LogRocket (optional)
LOGROCKET_APP_ID=

# ============================================
# Email Service (Transactional)
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@yourdomain.com

# ============================================
# AWS Configuration (if using AWS services)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name

# ============================================
# Vercel Deployment (if using Vercel)
# ============================================
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# ============================================
# Backup Configuration
# ============================================
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_RETENTION_DAYS=30

# ============================================
# Feature Flags
# ============================================
FEATURE_AI_INSIGHTS_ENABLED=true
FEATURE_TEMPLATE_MARKETPLACE_ENABLED=true
FEATURE_REAL_TIME_ANALYTICS_ENABLED=true

# ============================================
# Performance & Optimization
# ============================================
# CDN Configuration (if using external CDN)
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Image Optimization Service (Cloudinary, Imgix, etc.)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Security Headers
# ============================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ============================================
# Webhook Secrets
# ============================================
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
FACEBOOK_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# Application Insights
# ============================================
LOG_LEVEL=info
ENABLE_DEBUG_LOGGING=false
ENABLE_QUERY_LOGGING=false
