# Secrets. The API key is server-side only per the vendor docs.
.env

# The archive itself. Large, append-only, backed up separately.
data/

node_modules/
*.log

# Generated site output; rebuild with `node web/build-site.js`
web/dist/

# Deploy target; machine-specific, never committed
deploy.conf
# droplet.conf and any disabled copy: the Mac no longer publishes, and a stale
# one would let a local refresh overwrite the droplet's own build.
droplet.conf*

# Object storage target; machine-specific, never committed
spaces.conf
production.conf

# The full-resolution logo cut-out. Regenerated from the artwork beside it by
# `node tools/make-assets.js`, so it is an output kept for convenience rather
# than an input worth 1.4MB of history. The artwork itself IS committed: it is
# the one file here that cannot be rebuilt.
web/assets/source/badge-full.png
