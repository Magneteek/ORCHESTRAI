# ═══════════════════════════════════════════════════════════════════════
# ORCHESTRAI Competitive Intelligence System - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# Meta Ad Library API Configuration
# ─────────────────────────────────────────────────────────────────────────
# Get your access token from: https://developers.facebook.com/tools/explorer
# Create an app at: https://developers.facebook.com/apps

META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
META_API_VERSION=v18.0

# Meta API Rate Limiting
META_API_RATE_LIMIT_PER_HOUR=200
META_API_REQUESTS_PER_SECOND=5

# ─────────────────────────────────────────────────────────────────────────
# Apify Configuration
# ─────────────────────────────────────────────────────────────────────────
# Sign up at: https://apify.com
# Get API token from: https://console.apify.com/account/integrations

APIFY_API_TOKEN=your_apify_token_here
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-ads-scraper
APIFY_CONCURRENT_ACTORS=3
APIFY_MAX_REQUESTS_PER_RUN=1000

# ─────────────────────────────────────────────────────────────────────────
# AI Analysis APIs
# ─────────────────────────────────────────────────────────────────────────
# Claude API for copy analysis
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096

# OpenAI GPT-4 Vision for visual analysis
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4-vision-preview
OPENAI_MAX_TOKENS=2048

# AI Analysis Configuration
AI_ANALYSIS_BATCH_SIZE=50
AI_ANALYSIS_RETRY_ATTEMPTS=3
AI_ANALYSIS_RETRY_DELAY_MS=2000

# ─────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/competitive_intelligence
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=competitive_intelligence
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache Configuration
REDIS_CACHE_TTL_SECONDS=86400
REDIS_AD_DATA_TTL=3600
REDIS_API_RESPONSE_TTL=300

# ─────────────────────────────────────────────────────────────────────────
# Storage Configuration (Cloudflare R2 or AWS S3)
# ─────────────────────────────────────────────────────────────────────────
# Cloudflare R2 (recommended)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=facebook-ads-creative
R2_PUBLIC_URL=https://your-bucket.r2.dev

# AWS S3 (alternative)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=facebook-ads-creative

# Storage Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=image/jpeg,image/png,video/mp4,video/quicktime

# ─────────────────────────────────────────────────────────────────────────
# Email & Alert Configuration
# ─────────────────────────────────────────────────────────────────────────
# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Alert Recipients
ALERT_EMAIL_FROM=competitive-intel@yourcompany.com
ALERT_EMAIL_RECIPIENTS=admin@yourcompany.com,manager@yourcompany.com

# Webhook Configuration
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
WEBHOOK_TOKEN=your_webhook_secret_token

# Slack Integration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#competitive-intel

# ─────────────────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5600
API_BASE_URL=http://localhost:5600
DASHBOARD_URL=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here_generate_random_string
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
API_KEY_LENGTH=32

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_PER_CLIENT=true

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ─────────────────────────────────────────────────────────────────────────
# Pipeline & Scheduling Configuration
# ─────────────────────────────────────────────────────────────────────────
# Cron schedules (use cron syntax)
AD_COLLECTION_CRON=0 6 * * *
AD_ANALYSIS_CRON=0 8 * * *
LIBRARY_UPDATE_CRON=0 12 * * *
COMPETITOR_CHECK_CRON=0 */6 * * *

# Pipeline Configuration
MAX_CONCURRENT_PIPELINES=5
PIPELINE_TIMEOUT_MS=600000
PIPELINE_RETRY_ATTEMPTS=3

# Collection Limits
MAX_ADS_PER_COLLECTION_RUN=500
MAX_COMPETITORS_TRACKED=100
MAX_KEYWORDS_TRACKED=50

# ─────────────────────────────────────────────────────────────────────────
# Performance Scoring Configuration
# ─────────────────────────────────────────────────────────────────────────
# Scoring Weight Distribution (must sum to 1.0)
SCORE_LONGEVITY_WEIGHT=0.40
SCORE_ITERATION_WEIGHT=0.25
SCORE_ADVERTISER_QUALITY_WEIGHT=0.20
SCORE_INDUSTRY_RELEVANCE_WEIGHT=0.15

# Longevity Thresholds (days)
LONGEVITY_EXCELLENT_DAYS=60
LONGEVITY_GOOD_DAYS=30
LONGEVITY_AVERAGE_DAYS=14
LONGEVITY_POOR_DAYS=7

# ─────────────────────────────────────────────────────────────────────────
# Industry & Classification Configuration
# ─────────────────────────────────────────────────────────────────────────
# Target Industries (comma-separated)
TARGET_INDUSTRIES=dental_b2c,dental_b2b,ai_saas

# Default Keywords by Industry
DENTAL_B2C_KEYWORDS=dental implants,cosmetic dentistry,teeth whitening,invisalign,braces
DENTAL_B2B_KEYWORDS=CBCT scanner,dental 3D printer,intraoral scanner,practice management software
AI_SAAS_KEYWORDS=AI chatbot,automation software,AI productivity,machine learning platform

# Geographic Markets (ISO country codes)
# Priority markets: ES (Spain), NL (Netherlands), BE (Belgium), DE (Germany)
TARGET_MARKETS=ES,NL,BE,DE,AT,CH,US,CA,GB

# ─────────────────────────────────────────────────────────────────────────
# Logging & Monitoring
# ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/competitive-intelligence.log
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m

# Sentry Error Tracking (optional)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────
ENABLE_APIFY_SCRAPING=true
ENABLE_AI_ANALYSIS=true
ENABLE_VISUAL_ANALYSIS=true
ENABLE_EMAIL_ALERTS=true
ENABLE_WEBHOOK_ALERTS=true
ENABLE_COMPETITOR_TRACKING=true
ENABLE_AUTOMATIC_COLLECTIONS=true
ENABLE_TEMPLATE_GENERATION=true

# ─────────────────────────────────────────────────────────────────────────
# Client Portal & Multi-Tenant Configuration
# ─────────────────────────────────────────────────────────────────────────
# Subscription Tiers
TIER_STARTER_EXPORT_LIMIT=10
TIER_PROFESSIONAL_EXPORT_LIMIT=100
TIER_AGENCY_EXPORT_LIMIT=999999

# Default Tier
DEFAULT_SUBSCRIPTION_TIER=professional

# ─────────────────────────────────────────────────────────────────────────
# Development & Testing
# ─────────────────────────────────────────────────────────────────────────
DEBUG=false
MOCK_AI_RESPONSES=false
SKIP_EXTERNAL_API_CALLS=false
TEST_DATABASE_URL=postgresql://localhost:5432/competitive_intelligence_test

# ═══════════════════════════════════════════════════════════════════════
# End of Configuration
# ═══════════════════════════════════════════════════════════════════════
