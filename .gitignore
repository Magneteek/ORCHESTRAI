# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Temporary files
temp/
*.tmp
*.temp

# Build outputs
dist/
build/
out/

# Testing
coverage/

# ORCHESTRAI specific
orchestrai-shared/logs/*
!orchestrai-shared/logs/.gitkeep
projects/*/temp/
cache/

# Local machine settings (contains hardcoded paths and one-time permissions)
settings.local.json

# MCP config — contains live API tokens and machine-specific paths (synced via Syncthing)
.mcp.json

# Session data
sessions/

# Playwright MCP runtime state
.playwright-mcp/

# Root-level screenshots and client design review images
/*.png
/*.jpeg
/*.jpg

# CRITICAL: Never commit client project files to git
# Only system architecture and templates should be in version control
projects/quartziq-*/
projects/drnl-*/
projects/nasmehpg-*/
projects/redeyemonkey-*/
projects/rezensia-*/
projects/dental-3d-*/
# Catch-all for any client project directories
projects/*/
# But allow the projects directory structure itself
!projects/
!projects/.gitkeep

# Redis dumps
dump.rdb

# Database files
*.db
*.sqlite
*.sqlite3

# TypeScript
*.tsbuildinfo

# Frontend specific (handled in frontend .gitignore)
Orchestrai-frontend/.next/
Orchestrai-frontend/out/
Orchestrai-frontend/dist/

# Prevent test files and summaries in root directory
/*-COMPLETE.md
/*-SUMMARY.md
/*-REPORT.md
/*-RESULTS.md
/*-TEST*.md
/PHASE-*.md
/*-ANALYSIS.md
/test-*.js
/test-*.sh
/*-test.js
/tracking-report-*.json
/*-scan.json
/postproceduralna-*.txt
/CLEANUP-PLAN*.md

# Test directories
/tests/
/tools/
/Copy/
/applications/

# Agent backups (deprecated agents kept locally for reference only)
.claude/agents-backup-*/

# Backup files (use git history instead of manual backups)
*.BACKUP.js
*-backup.js
*-transformed.js
*.js.backup
*.backup
*.bak
*.old
*-old.js
*.orig
~*
.*.swp
.*.swo

# Build cache files
*.pack.old
*.pack.gz.old

# Next.js build output (any app in this repo)
.next/

# Editor / workspace config
.obsidian/

# Duplicated env files created by macOS ("Finder" copies) - never commit secrets
.env *
*.env *
.env.*.local

# Pipeline run artifacts (client work product, mirrors the projects/ rule above)
pipeline-runs/
*-snapshot.md
