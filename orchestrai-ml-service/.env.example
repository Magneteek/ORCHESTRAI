# Application
APP_NAME=orchestrai-ml-service
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5501,http://localhost:3000

# Database
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://postgres:password@localhost:5432/orchestrai_ml

# Model Configuration
MODEL_STORAGE_PATH=/models
MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL=3600

# ML Settings
AGENT_SELECTION_MODEL_VERSION=latest
QUALITY_PREDICTION_MODEL_VERSION=latest
PIPELINE_OPTIMIZATION_MODEL_VERSION=latest

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT=30
MAX_BATCH_SIZE=32

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=8000

# Integration with ORCHESTRAI Node.js
ORCHESTRAI_NODE_URL=http://localhost:5501
ORCHESTRAI_API_KEY=your-api-key-here
